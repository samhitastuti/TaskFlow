generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String   @id @default(uuid())
  email                     String   @unique
  password_hash             String
  display_name              String
  created_at                DateTime @default(now())
  last_seen_at              DateTime @default(now())
  onboarding_completed      Boolean  @default(false)
  working_hours_start       String   @default("09:00")
  working_hours_end         String   @default("18:00")
  timezone                  String   @default("UTC")
  scoring_weight_urgency    Float    @default(0.4)
  scoring_weight_priority   Float    @default(0.4)
  scoring_weight_duration   Float    @default(0.2)
  notification_preferences  Json?    @default("{}")

  tasks          Task[]
  sessions       Session[]
  scoreSnapshots ScoreSnapshot[]
  actionLogs     ActionLog[]
  notifications  Notification[]
}

enum Category {
  work
  personal
  health
  learning
  other
}

enum TaskStatus {
  pending
  in_progress
  completed
  backlog
  archived
}

enum Recurrence {
  none
  daily
  weekly
}

model Task {
  id                   String     @id @default(uuid())
  user_id              String
  user                 User       @relation(fields: [user_id], references: [id])
  title                String     @db.VarChar(120)
  notes                String?
  deadline             DateTime
  duration_minutes     Int
  priority_weight      Float
  category             Category
  status               TaskStatus @default(pending)
  recurrence           Recurrence @default(none)
  recurrence_parent_id String?
  dependencies         String[]   @default([])
  composite_score      Float?
  skip_count           Int        @default(0)
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt
  completed_at         DateTime?
  deleted_at           DateTime?
  client_updated_at    DateTime?

  sessions       Session[]
  scoreSnapshots ScoreSnapshot[]
  actionLogs     ActionLog[]
  notifications  Notification[]

  @@index([user_id])
}

enum SessionStatus {
  active
  completed
  abandoned
}

model Session {
  id                       String        @id @default(uuid())
  user_id                  String
  user                     User          @relation(fields: [user_id], references: [id])
  task_id                  String
  task                     Task          @relation(fields: [task_id], references: [id])
  started_at               DateTime      @default(now())
  ended_at                 DateTime?
  planned_duration_minutes Int
  actual_duration_minutes  Int?
  status                   SessionStatus @default(active)
  pause_log                Json?         @default("[]")

  @@index([user_id])
  @@index([task_id])
}

model ScoreSnapshot {
  id                 String   @id @default(uuid())
  task_id            String
  task               Task     @relation(fields: [task_id], references: [id])
  user_id            String
  user               User     @relation(fields: [user_id], references: [id])
  score              Float
  urgency_component  Float
  priority_component Float
  duration_component Float
  snapshot_at        DateTime @default(now())

  @@index([user_id])
  @@index([task_id])
}

enum ActionType {
  task_created
  task_updated
  task_completed
  task_deleted
  task_skipped
  session_started
  session_ended
  task_rescheduled
  dependency_resolved
}

model ActionLog {
  id         String     @id @default(uuid())
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])
  task_id    String?
  task       Task?      @relation(fields: [task_id], references: [id])
  action     ActionType
  payload    Json?
  created_at DateTime   @default(now())

  @@index([user_id])
}

enum NotificationType {
  deadline_approaching
  session_overrun
  conflict_detected
  daily_summary
}

model Notification {
  id            String           @id @default(uuid())
  user_id       String
  user          User             @relation(fields: [user_id], references: [id])
  task_id       String?
  task          Task?            @relation(fields: [task_id], references: [id])
  type          NotificationType
  scheduled_for DateTime
  sent_at       DateTime?
  dismissed_at  DateTime?

  @@index([user_id])
}
